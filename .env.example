# Pick one LLM provider and fill in its key. src/config.py reads whichever is set.
OPENAI_API_KEY=
# or, if using a free/local option instead:
# GROQ_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# Optional: web search fallback tool
TAVILY_API_KEY=

# Optional: tracing/observability
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=iitbhu-placement-assistant
